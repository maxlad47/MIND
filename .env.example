# Front (publiques)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_VAPID_PUBLIC_KEY=

# Edge Functions uniquement (jamais dans le front) — à définir avec `supabase secrets set`
ANTHROPIC_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
COACH_EMAIL=

# Garmin — clé personnelle (front : affiche la liaison) · accès officiel Starter (désactivé tant que Garmin n'a pas répondu)
VITE_GARMIN_PERSONAL=true
VITE_GARMIN_ENABLED=false
# Edge Functions Garmin uniquement — `supabase secrets set --env-file .env.garmin.local`
GARMIN_KEY_SECRET=   # openssl rand -base64 32  (32 octets en base64 : chiffre les clés Garmin)
